                                    Category:
                                </label>
                            </div>
                            <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                                <input id="txtCategoryName" maxlength="50" type="text" onkeyup="return ReplaceStr2(this);" style="width: 100%" class="form-control" />
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-4">
                                <label class="control-label" align="left">
                                    Description:
                                </label>
                            </div>
                            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-10">
                                <textarea class="form-control" id="txtDescriptionCat" rows="5" cols="1" style="width: 100%; height: 150px" onkeyup="CountChar(this.value,500,'cntCat', this.id); return ReplaceStr2(this);"></textarea>
