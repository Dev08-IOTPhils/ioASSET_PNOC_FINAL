                            </div>
                            <br />
                        </div>
                    </div>
                    <div class="modal-footer" id="completetransaction">
                        <button type="button" class="btn btn-sm btn-primary pull-right" id="btnAddAttachment" onclick="AddAttachment()">&nbsp;&nbsp;Add Attachment&nbsp;&nbsp;</button>
                    </div>
                </div>
            </div>
        </div>
