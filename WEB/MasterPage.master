    <style>
      
        tfoot input {
            width: 100%;
            padding: 0px;
            /*border-spacing :2px 2px;
            box-sizing: border-box;*/
        }

        tfoot {
            display: table-header-group;
            border: none;
        }

        .datepicker{
            z-index: 9999 !important
        }

        .NewNotif {
            background-color: whitesmoke;
        }

            .NewNotif:hover {
                background-color: /*#d8f4ff*/ lightgray;
            }

        .NotifImage {
            display: inline-block;
            height: 100%;
            vertical-align: middle;
        }

        /*table {
            table-layout: fixed;
            word-wrap: break-word;
        }*/

        /*.navbar-nav>.notifications-menu>.dropdown-menu>li .menu, .navbar-nav>.messages-menu>.dropdown-menu>li .menu, .navbar-nav>.tasks-menu>.dropdown-menu>li .menu {
    max-height: inherit;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-y:hidden;
}*/

        @media print {
            html, body {
                height: auto;
            }

            .dt-print-table, .dt-print-table thead, .dt-print-table th, .dt-print-table tr {
                border: 0 none !important;
            }

            tfoot td {
                border: none;
            }
        }

        .dataTables_scrollHeadInner {
            width: 100% !important;
        }

            .dataTables_scrollHeadInner table {
                width: 100% !important;
            }

        /*loading animation*/
        .se-pre-con {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('/Image/Icon/circle-loading-animation.gif') center no-repeat #fff; /*<img src="Image/AssetISlogo.png" />*/
        }

        .swal-modal .swal-text {
            text-align: center;
        }

        .btn-dict-pref {
            background-color : #7FB069;
        }
    </style>
    
